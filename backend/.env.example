# Application Configuration
APP_NAME=DisputePilot AI
APP_ENV=development
APP_MODE=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Neon PostgreSQL Database & pgvector
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB_NAME?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173

# PayPal Sandbox Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# AI & RAG Configuration (Neon PostgreSQL + pgvector)
AI_MODE=mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
VECTOR_STORE=pgvector

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIRECTORY=storage/uploads
MAX_UPLOAD_SIZE_MB=20
